# PoHI Protocol Configuration
# ==========================

# Mock mode for development (set to "true" to skip real API calls)
POHI_MOCK_PROVIDERS=false

# ===================
# Data Storage (Vercel KV / Upstash Redis)
# ===================
# Configure persistent storage for attestations in production.
# If not set, uses in-memory storage (data lost on restart).
# Get credentials from Vercel Dashboard > Storage > KV

# Vercel KV REST API URL
# KV_REST_API_URL=https://your-kv-store.kv.vercel-storage.com

# Vercel KV REST API Token
# KV_REST_API_TOKEN=your_token_here

# ===================
# World ID Configuration
# ===================
# Get these from https://developer.worldcoin.org/

# Your World ID App ID (starts with "app_")
NEXT_PUBLIC_WORLD_ID_APP_ID=app_your_app_id_here

# Your Action ID (the action you created in the developer portal)
NEXT_PUBLIC_WORLD_ID_ACTION=your_action_name

# World ID API endpoint for verification
WORLD_ID_API_URL=https://developer.worldcoin.org/api/v2/verify

# ===================
# Gitcoin Passport Configuration
# ===================
# Get your API key from https://passport.gitcoin.co/

# Gitcoin Passport API key
GITCOIN_PASSPORT_API_KEY=

# Minimum passport score required (default: 20)
GITCOIN_PASSPORT_MIN_SCORE=20

# ===================
# BrightID Configuration
# ===================
# Learn more at https://brightid.gitbook.io/

# BrightID context name
BRIGHTID_CONTEXT=pohi

# BrightID node URL (default: https://app.brightid.org/node/v5)
BRIGHTID_NODE_URL=https://app.brightid.org/node/v5

# Public-facing context for the frontend
NEXT_PUBLIC_BRIGHTID_CONTEXT=pohi
NEXT_PUBLIC_BRIGHTID_NODE_URL=https://app.brightid.org/node/v5

# ===================
# Civic Configuration
# ===================
# Learn more at https://docs.civic.com/

# Civic gatekeeper network address
CIVIC_GATEKEEPER_NETWORK=ignREusXmGrscGNUesoU9mxfds9AiYTezUKex2PsZV6

# ===================
# Proof of Humanity Configuration
# ===================
# Learn more at https://proofofhumanity.id/

# The Graph subgraph URL for PoH
POH_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/kleros/proof-of-humanity-mainnet

# ===================
# Optional: GitHub Integration
# ===================
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ===================
# Webhook Notifications
# ===================
# Configure outgoing webhooks to notify external services when attestations are approved
# Useful for: Slack notifications, Discord bots, custom CI/CD systems, audit logs

# Webhook endpoint URL (POST requests will be sent here)
# POHI_WEBHOOK_URL=https://your-service.com/webhook

# Secret for HMAC-SHA256 signature (X-PoHI-Signature header)
# POHI_WEBHOOK_SECRET=your_webhook_secret_here

# Request timeout in milliseconds (default: 10000)
# POHI_WEBHOOK_TIMEOUT_MS=10000
